[
  {
    "name": "sec_13d_filings",
    "description": "List Schedule 13D / 13G beneficial-ownership filings (and their amendments, 13D/A and 13G/A) for one issuer — AUTHORITATIVE source for \"who owns 5%+ of $TICKER\" and \"has an activist filed a 13D on this company\". Takes a ticker or company name (auto-resolved to CIK) or a CIK directly. Each row flags `structured: true/false` — filings from SEC's 2024 XML rule onward are structured and feed straight into sec_13d_filing; older ones are plain text/HTML only. Use sec_13d_filing on any accession_number returned here to get the actual reporting-owner data (percent of class, voting power, purpose).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ticker_or_cik": {
          "type": "string",
          "description": "Stock ticker (\"GME\"), company name (\"GameStop\"), or SEC CIK, of the ISSUER whose beneficial-ownership filings to list."
        },
        "ticker": {
          "type": "string",
          "description": "Alias for ticker_or_cik."
        },
        "cik": {
          "type": "string",
          "description": "Alias for ticker_or_cik."
        },
        "form_type": {
          "type": "string",
          "enum": [
            "all",
            "13D",
            "13D/A",
            "13G",
            "13G/A"
          ],
          "description": "Filter to one form family. \"13D\" / \"13G\" exclude amendments; \"13D/A\" / \"13G/A\" are amendments only. Default \"all\"."
        },
        "limit": {
          "type": "number",
          "description": "Max rows to return (1-40, default 20)."
        }
      },
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "cik": {
          "type": "string"
        },
        "issuer_name": {
          "type": "string"
        },
        "tickers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filter_form_type": {
          "type": "string"
        },
        "returned": {
          "type": "number"
        },
        "filings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession_number": {
                "type": "string"
              },
              "form": {
                "type": "string"
              },
              "form_family": {
                "type": "string"
              },
              "is_amendment": {
                "type": "boolean"
              },
              "filing_date": {
                "type": "string"
              },
              "structured": {
                "type": "boolean"
              },
              "primary_document": {
                "type": "string"
              },
              "filing_index_url": {
                "type": "string"
              },
              "primary_document_url": {
                "type": "string"
              }
            },
            "required": [
              "accession_number",
              "form",
              "is_amendment",
              "filing_date",
              "structured",
              "filing_index_url"
            ]
          }
        },
        "data_as_of": {
          "type": "string"
        }
      },
      "required": [
        "cik",
        "issuer_name",
        "returned",
        "filings",
        "data_as_of"
      ]
    }
  },
  {
    "name": "sec_13d_filing",
    "description": "Parse ONE Schedule 13D or 13G filing by issuer + accession_number (get the accession_number from sec_13d_filings). Returns every reporting owner (the \"group members\") with percent of class, sole/shared voting power, sole/shared dispositive power, and aggregate shares owned; for Schedule 13D, also Item 4 — the free-text \"Purpose of Transaction\", which is where an activist states its intent (board seats, a merger, liquidation, or \"no plans\"). Filings from before SEC's 2024 structured-XML rule have no machine-readable fields — this returns `structured: false` plus the bounded plain text of the filing instead of silently returning empty data.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ticker_or_cik": {
          "type": "string",
          "description": "Ticker, company name, or CIK of the ISSUER the filing is about (same value you passed to sec_13d_filings)."
        },
        "ticker": {
          "type": "string",
          "description": "Alias for ticker_or_cik."
        },
        "cik": {
          "type": "string",
          "description": "Alias for ticker_or_cik."
        },
        "accession_number": {
          "type": "string",
          "description": "The filing's SEC accession number, e.g. \"0001104659-25-086308\" (dashes optional). From sec_13d_filings."
        }
      },
      "required": [
        "accession_number"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "cik": {
          "type": "string"
        },
        "issuer_name": {
          "type": "string"
        },
        "accession_number": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "form_family": {
          "type": "string"
        },
        "is_amendment": {
          "type": "boolean"
        },
        "structured": {
          "type": "boolean"
        },
        "filing_index_url": {
          "type": "string"
        },
        "primary_document_url": {
          "type": "string"
        },
        "securities_class_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "reporting_owners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "cik": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "citizenship_or_organization": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type_of_reporting_person": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sole_voting_power": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "shared_voting_power": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "sole_dispositive_power": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "shared_dispositive_power": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "aggregate_amount_owned": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "percent_of_class": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "member_of_group_box": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "item4_purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "object"
        },
        "raw_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_text_truncated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_as_of": {
          "type": "string"
        }
      },
      "required": [
        "cik",
        "issuer_name",
        "accession_number",
        "form",
        "is_amendment",
        "structured",
        "filing_index_url",
        "data_as_of"
      ]
    }
  },
  {
    "name": "sec_13d_search",
    "description": "MARKET-WIDE search of Schedule 13D / 13G beneficial-ownership filings by FILING DATE — no ticker needed. AUTHORITATIVE for \"which activist investors filed new 13Ds this month and which companies did they target\", \"who disclosed a 5%+ stake in anything last week\", \"new 13G filings since Monday\". Returns, per filing: the SUBJECT company (the issuer targeted, with ticker and CIK), the FILERS (investors / reporting persons, with CIK), form, filing date, and whether it is an amendment. By default only NEW filings (amendments excluded; set include_amendments true to add 13D/A and 13G/A). For the first `enrich` structured filings (post-2024 XML rule, default 5, max 10) it also reads the filing itself and adds the reporting owners' percent of class and shares owned, the event date, and — for 13D — the Item 4 \"Purpose of Transaction\" text (the activist signal). Rows beyond `enrich` carry the index fields only; pass their accession to sec_13d_filing for the full parse. `total_matches` is the true count for the window, `scanned` how many were read (at most 300), and `truncated` says honestly when the window held more than was scanned — narrow the date range rather than assuming completeness. Default window: the last 30 days.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "form_family": {
          "type": "string",
          "enum": [
            "13D",
            "13G",
            "all"
          ],
          "description": "\"13D\" (default; active / activist stakes), \"13G\" (passive 5%+ holders) or \"all\"."
        },
        "start_date": {
          "type": "string",
          "description": "First filing date, YYYY-MM-DD. Default: 30 days before end_date."
        },
        "end_date": {
          "type": "string",
          "description": "Last filing date, YYYY-MM-DD. Default: today."
        },
        "include_amendments": {
          "type": "boolean",
          "description": "Include 13D/A and 13G/A amendments. Default false (new filings only)."
        },
        "limit": {
          "type": "number",
          "description": "Max filings to return (1-100, default 25), newest first."
        },
        "enrich": {
          "type": "number",
          "description": "How many of the returned structured filings to read in full for percent of class and Item 4 purpose (0-10, default 5). Each is one SEC document fetch."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "form_family": {
          "type": "string"
        },
        "date_range": {
          "type": "object"
        },
        "include_amendments": {
          "type": "boolean"
        },
        "total_matches": {
          "type": "number"
        },
        "scanned": {
          "type": "number"
        },
        "matched_after_filter": {
          "type": "number"
        },
        "truncated": {
          "type": "boolean"
        },
        "returned": {
          "type": "number"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession_number": {
                "type": "string"
              },
              "form": {
                "type": "string"
              },
              "is_amendment": {
                "type": "boolean"
              },
              "filing_date": {
                "type": "string"
              },
              "subject_company": {
                "type": "object"
              },
              "filers": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "subject_basis": {
                "type": "string"
              },
              "structured": {
                "type": "boolean"
              },
              "detail": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "filing_index_url": {
                "type": "string"
              }
            },
            "required": [
              "accession_number",
              "form",
              "is_amendment",
              "filing_date",
              "subject_company",
              "filers"
            ]
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "data_as_of": {
          "type": "string"
        }
      },
      "required": [
        "form_family",
        "date_range",
        "total_matches",
        "scanned",
        "truncated",
        "returned",
        "results",
        "source",
        "data_as_of"
      ]
    }
  },
  {
    "name": "sec_13d_amendment_diff",
    "description": "Given one 13D/A or 13G/A amendment (issuer + accession_number), find the SAME reporting group's prior filing in the chain and diff what changed: percent of class, aggregate shares owned, sole/shared voting & dispositive power (per reporting owner, matched by CIK or name), and — for 13D — whether the Item 4 purpose text changed. Walks back through the issuer's filing history (bounded, never a bulk crawl) matching on reporting-owner identity, since EDGAR does not carry an explicit \"previous accession\" link for this form family. Reports `prior_filing_found: false` honestly if no matching prior filing turns up within the scan bound, or if the chain predates the structured-XML rule (diffing free text is not meaningful).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ticker_or_cik": {
          "type": "string",
          "description": "Ticker, company name, or CIK of the ISSUER."
        },
        "ticker": {
          "type": "string",
          "description": "Alias for ticker_or_cik."
        },
        "cik": {
          "type": "string",
          "description": "Alias for ticker_or_cik."
        },
        "accession_number": {
          "type": "string",
          "description": "Accession number of the AMENDMENT (13D/A or 13G/A) to diff against its predecessor. Also accepts an original 13D/13G, in which case there is by definition no prior filing."
        }
      },
      "required": [
        "accession_number"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "cik": {
          "type": "string"
        },
        "issuer_name": {
          "type": "string"
        },
        "current": {
          "type": "object",
          "properties": {
            "accession_number": {
              "type": "string"
            },
            "form": {
              "type": "string"
            },
            "form_family": {
              "type": "string"
            },
            "is_amendment": {
              "type": "boolean"
            },
            "filing_date": {
              "type": "string"
            },
            "structured": {
              "type": "boolean"
            },
            "primary_document": {
              "type": "string"
            },
            "filing_index_url": {
              "type": "string"
            },
            "primary_document_url": {
              "type": "string"
            }
          },
          "required": [
            "accession_number",
            "form",
            "is_amendment",
            "filing_date",
            "structured",
            "filing_index_url"
          ]
        },
        "prior_filing_found": {
          "type": "boolean"
        },
        "prior": {
          "type": [
            "object",
            "null"
          ]
        },
        "scanned": {
          "type": "number"
        },
        "scan_limit": {
          "type": "number"
        },
        "changes": {
          "type": [
            "object",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_as_of": {
          "type": "string"
        }
      },
      "required": [
        "cik",
        "issuer_name",
        "current",
        "prior_filing_found",
        "scanned",
        "scan_limit",
        "data_as_of"
      ]
    }
  }
]
